msgstr ""

#: includes/class-docs.php:587
msgid "Strict-Transport-Security (HSTS, includeSubDomains, preload)"
msgstr ""

#: includes/class-docs.php:590
msgid "Forces HTTPS-only connections in modern browsers once your entire production domain has a valid TLS certificate."
msgstr ""

#: includes/class-docs.php:591
msgid "NEVER turn on over plain HTTP (WPEPP hides it on non-HTTPS). Never check includeSubDomains if staging/mail subdomains lack HTTPS, and never check preload unless committing permanently to hstspreload.org."
